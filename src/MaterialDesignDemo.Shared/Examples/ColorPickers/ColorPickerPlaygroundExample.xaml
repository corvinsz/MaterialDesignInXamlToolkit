<UserControl x:Class="MaterialDesignDemo.Shared.Examples.ColorPickers.ColorPickerPlaygroundExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Dock="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaterialDesignDemo.Shared.Examples.ColorPickers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
  <materialDesign:Card Padding="16">
    <StackPanel>
      <TextBlock Margin="0,0,0,8"
                 Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                 Text="ColorPicker" />

      <TextBlock Margin="0,0,0,16"
                 Text="NumericUpDown is used to allow users to pick or type numeric values with optional step/limits."
                 TextWrapping="Wrap" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="2" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <smtx:XamlDisplay Grid.Column="0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          UniqueKey="ColorPickerPlaygroundExample_1">
          <materialDesign:ColorPicker Width="400"
                                      Height="240"
                                      HueSliderPosition="{Binding ElementName=lbSliderPosition, Path=SelectedItem.Dock}"
                                      ShowAlphaSlider="{Binding ElementName=cbShowAlphaSlider, Path=IsChecked}"
                                      ShowInput="{Binding ElementName=cbShowInput, Path=IsChecked}"
                                      ShowPreview="{Binding ElementName=cbShowPreview, Path=IsChecked}" />
        </smtx:XamlDisplay>

        <GridSplitter Grid.Column="1"
                      Width="2"
                      VerticalAlignment="Stretch" />

        <StackPanel Grid.Column="2" Margin="8">
          <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" Text="Options" />
          <TextBlock Text="HueSliderPosition" />
          <ListBox x:Name="lbSliderPosition"
                   ItemsSource="{Binding SliderPositions}"
                   Style="{StaticResource SegmentedListBox}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon VerticalAlignment="Center" Kind="{Binding Icon}" />
                  <TextBlock Text="{Binding Dock}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <CheckBox x:Name="cbShowAlphaSlider"
                    Content="ShowAlphaSlider"
                    IsChecked="true" />
          <CheckBox x:Name="cbShowInput"
                    Content="ShowInput"
                    IsChecked="true" />
          <CheckBox x:Name="cbShowPreview"
                    Content="ShowPreview"
                    IsChecked="true" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </materialDesign:Card>
</UserControl>
